#include <iostream>
#include <iomanip>
using namespace std;

int main() 
{
    double x,y,z,SI,T;
    cout<<"Enter the amount:";
    cin>>x;
    cout<<"Enter the time:";
    cin>>y;
    cout<<"Enter the interest:";
    cin>>z;
    SI=x*y*z/100;
    T=SI+x;
    cout<<fixed<<setprecision(2)<<"Simple Interest:"<<SI<<"\nTotal Amount:"<<T;

}
